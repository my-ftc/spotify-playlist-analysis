// This is your Prisma schema file for MySQL

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql" // Change to MySQL provider
  url      = env("DATABASE_URL")
}

model Followers {
  id            Int       @id @default(autoincrement())
  playlist_id   String    @unique
  follower_count Json     // Store as a JSON object in MySQL
  created_at    DateTime  @default(now())
}
